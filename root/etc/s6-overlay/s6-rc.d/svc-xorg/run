#!/usr/bin/with-contenv bash

# bail early on wayland
if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]]; then
  sleep infinity
fi

# Cleanup
rm -f /tmp/.X1-lock

# M3 (SLU rhel9 fork addition): real X.Org + NVIDIA DDX path.
# Guard (per projectRules guard-predicate rule): env-marker + file-exists.
# On upstream fedora44 nothing sets XSERVER_BACKEND and /usr/local/bin/
# selu-xorg-config does not exist — the block is a no-op there. When the
# opt-in is set but the config script exits non-zero (no GPU, download
# failure, xconfig failure), we fall through to the Xvfb path below
# unchanged (preserves M2 behavior). See memory-bank F58 + 2026-08-31 ADR.
if [ "${XSERVER_BACKEND:-}" = "nvidia-xorg" ] \
   && [ -x /usr/local/bin/selu-xorg-config ] \
   && [ -x /usr/libexec/Xorg ]; then
  if DRIVER="$(/usr/local/bin/selu-xorg-config 2>/tmp/selu-xorg-config.log)"; then
    echo "[svc-xorg] M3 Xorg path: driver=${DRIVER} (see /tmp/selu-xorg-config.log)"
    # Zink / Mesa software-GL env belongs to the applications in the session
    # when the display server is Xvfb. With the vendor's DDX in charge, the
    # Mesa loader is bypassed; stripping the env here keeps `glxinfo` output
    # honest (renderer = NVIDIA, not llvmpipe) and prevents the DE from
    # accidentally re-entering a Mesa path if it queries env directly.
    unset GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 \
          LIBGL_ALWAYS_SOFTWARE MESA_GL_VERSION_OVERRIDE DISABLE_DRI3
    # A crashed Xorg leaves its lock + socket; the replacement would refuse
    # the same DISPLAY number without this cleanup.
    DISPLAY_NUM="${DISPLAY#:}"
    DISPLAY_NUM="${DISPLAY_NUM%%.*}"
    if [ -n "${DISPLAY_NUM}" ] && ! pgrep -f "Xorg ${DISPLAY}( |$)" >/dev/null 2>&1; then
      rm -f "/tmp/.X${DISPLAY_NUM}-lock" "/tmp/.X11-unix/X${DISPLAY_NUM}"
    fi
    # Xorg creates these dirs only as root. This container is rootful (F28),
    # but the mkdir is idempotent and harmless either way.
    mkdir -pm1777 /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null || true
    # Real Xorg wants a virtual terminal; give it a stable stand-in.
    [ -e /dev/tty7 ] || ln -snf /dev/ptmx /dev/tty7 2>/dev/null || true
    # Run the server in the background so we can prove it answers before
    # declaring readiness. If xdpyinfo doesn't succeed within 30s, kill the
    # process and exit non-zero — s6 respawns, the `finish` file adds a 2s
    # backoff, and the config script (idempotent) runs again.
    /usr/libexec/Xorg "${DISPLAY}" vt7 -noreset -novtswitch -sharevts \
      -nolisten tcp -ac -s 0 -dpms \
      +extension COMPOSITE +extension DAMAGE +extension GLX +extension RANDR \
      +extension RENDER +extension MIT-SHM +extension XFIXES +extension XTEST \
      -config /etc/X11/xorg.conf -logfile /tmp/Xorg.log &
    XORG_PID=$!
    trap 'kill "${XORG_PID}" 2>/dev/null || true' TERM INT
    READY=false
    for _ in $(seq 1 30); do
      if ! kill -0 "${XORG_PID}" 2>/dev/null; then
        echo "[svc-xorg] M3 Xorg died during startup (see /tmp/Xorg.log)" >&2
        exit 1
      fi
      if timeout 2 xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1; then
        READY=true; break
      fi
      sleep 1
    done
    if [ "${READY}" != "true" ]; then
      echo "[svc-xorg] M3 Xorg did not answer within 30s; killing (see /tmp/Xorg.log)" >&2
      kill -9 "${XORG_PID}" 2>/dev/null || true
      wait "${XORG_PID}" 2>/dev/null || true
      exit 1
    fi
    echo "[svc-xorg] M3 Xorg ${DISPLAY} is serving clients on the ${DRIVER} driver"
    wait "${XORG_PID}"
    exit $?
  else
    echo "[svc-xorg] M3: selu-xorg-config declined, falling back to Xvfb"
    cat /tmp/selu-xorg-config.log >&2 || true
  fi
fi

# Enable DRI3 support if detected
VFBCOMMAND=""
if ! which nvidia-smi && [ -e "/dev/dri/renderD128" ]; then
  VFBCOMMAND="-vfbdevice /dev/dri/renderD128"
fi
if [ -n "${DRINODE}" ]; then
  VFBCOMMAND="-vfbdevice ${DRINODE}"
fi
if [ "${DISABLE_DRI3,,}" != "false" ]; then
  VFBCOMMAND=""
fi

# Clamp virtual screen max size based on env
DEFAULT_RES="15360x8640"
if [ -n "${MAX_RES}" ]; then
  DEFAULT_RES="${MAX_RES}"
fi
if [ -n "${SELKIES_MANUAL_HEIGHT}" ] || [ -n "${SELKIES_MANUAL_WIDTH}" ]; then
  T_WIDTH="${SELKIES_MANUAL_WIDTH:-1024}"
  T_HEIGHT="${SELKIES_MANUAL_HEIGHT:-768}"
  if [ "${T_WIDTH}" = "0" ]; then T_WIDTH="1024"; fi
  if [ "${T_HEIGHT}" = "0" ]; then T_HEIGHT="768"; fi
  DEFAULT_RES="${T_WIDTH}x${T_HEIGHT}"
fi

# Run Xvfb server with required extensions
exec s6-setuidgid abc \
  /usr/bin/Xvfb \
    "${DISPLAY}" \
    -screen 0 "${DEFAULT_RES}x24" \
    -dpi "96" \
    +extension "COMPOSITE" \
    +extension "DAMAGE" \
    +extension "GLX" \
    +extension "RANDR" \
    +extension "RENDER" \
    +extension "MIT-SHM" \
    +extension "XFIXES" \
    +extension "XTEST" \
    +iglx \
    +render \
    -nolisten "tcp" \
    -ac \
    -noreset \
    -shmem \
    ${VFBCOMMAND}
